generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole {
  MEMBER
  ADMIN
  VENDOR
  RELATIONSHIP_MANAGER
}

enum Gender {
  MALE
  FEMALE
}

enum AccountStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum ProfileApprovalStatus {
  DRAFT
  PAYMENT_PENDING
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OTPType {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

model User {
  id String @id @default(cuid())

  fullName String?
  mobile String @unique
  email String? @unique
  password String?

  gender Gender?

  role UserRole @default(MEMBER)
  status AccountStatus @default(PENDING)

  mobileVerified Boolean @default(false)
  emailVerified Boolean @default(false)

  profile Profile?

  loginHistory LoginHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  payments Payment[]

  conversations ConversationParticipant[]

  messages Message[]

  notifications Notification[]

  vendor Vendor?

  auditLogs AuditLog[]
}
model Profile {
  id String @id @default(cuid())

  userId String @unique
  profileId String @unique

  profileCompletion Int @default(0)

  firstName String?
  lastName String?
  dateOfBirth DateTime?
  height Int?
  maritalStatus String?
  religion String?
  caste String?
  motherTongue String?

  isVisible Boolean @default(false)
  paymentCompleted Boolean @default(false)

  approvalStatus ProfileApprovalStatus @default(DRAFT)

  approvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  photos ProfilePhoto[]
  family             Family?
education          Education?
occupation         Occupation?
partnerPreference  PartnerPreference?
interestsSent      Interest[] @relation("InterestSender")
interestsReceived  Interest[] @relation("InterestReceiver")
shortlists         Shortlist[]
blocks             Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ProfilePhoto {
  id String @id @default(cuid())

  profileId String

  imageUrl String

  isPrimary Boolean @default(false)

  status PhotoStatus @default(PENDING)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OTP {
  id String @id @default(cuid())

  mobile String

  code String

  type OTPType

  expiresAt DateTime

  verified Boolean @default(false)

  createdAt DateTime @default(now())
}

model LoginHistory {
  id String @id @default(cuid())

  userId String

  ipAddress String?
  userAgent String?
  device    String?

  loginAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Family {
  id String @id @default(cuid())

  profileId String @unique

  fatherName String?
  motherName String?
  brothers Int? @default(0)
  sisters Int? @default(0)
  familyType String?
  familyStatus String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id String @id @default(cuid())

  profileId String @unique

  highestQualification String?
  college String?
  occupationField String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Occupation {
  id String @id @default(cuid())

  profileId String @unique

  profession String?
  company String?
  annualIncome String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PartnerPreference {
  id String @id @default(cuid())

  profileId String @unique

  minAge Int?
  maxAge Int?
  minHeight Int?
  maxHeight Int?

  preferredReligion String?
  preferredCaste String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
model Interest {
  id String @id @default(cuid())

  senderProfileId String
  receiverProfileId String

  status String @default("PENDING")

  sender Profile @relation("InterestSender", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiver Profile @relation("InterestReceiver", fields: [receiverProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Shortlist {
  id String @id @default(cuid())

  profileId String
  shortlistedProfileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Block {
  id String @id @default(cuid())

  profileId String
  blockedProfileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Subscription {
  id String @id @default(cuid())

  userId String

  planName String
  amount Decimal @db.Decimal(10,2)

  startDate DateTime
  endDate DateTime

  status SubscriptionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())

  userId String

  amount Decimal @db.Decimal(10,2)

  status PaymentStatus @default(PENDING)

  paymentGateway String?
  transactionId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id String @id @default(cuid())

  participants ConversationParticipant[]
  messages Message[]

  createdAt DateTime @default(now())
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  userId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId String

  message String @db.Text

  status MessageStatus @default(SENT)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())

  userId String

  title String
  body String @db.Text

  isRead Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vendor {
  id String @id @default(cuid())

  userId String @unique

  businessName String
  category String

  description String? @db.Text

  phone String
  email String?

  city String?
  state String?

  isVerified Boolean @default(false)

  status VendorStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  galleries VendorGallery[]
  reviews VendorReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorGallery {
  id String @id @default(cuid())

  vendorId String

  imageUrl String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorReview {
  id String @id @default(cuid())

  vendorId String

  rating Int

  review String? @db.Text

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
enum CouponType {
  PERCENTAGE
  FIXED
}

model MembershipPlan {
  id String @id @default(cuid())

  name String
  price Decimal @db.Decimal(10,2)
  durationDays Int

  canChat Boolean @default(true)
  canViewContact Boolean @default(true)
  canSendInterestUnlimited Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id String @id @default(cuid())

  code String @unique

  type CouponType

  value Decimal @db.Decimal(10,2)

  validFrom DateTime
  validTill DateTime

  maxUses Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model Banner {
  id String @id @default(cuid())

  title String

  imageUrl String

  redirectUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action String

  module String

  details String? @db.Text

  ipAddress String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AdminSetting {
  id String @id @default(cuid())

  registrationEnabled Boolean @default(true)

  autoApproveProfiles Boolean @default(false)

  maintenanceMode Boolean @default(false)

  gstPercentage Decimal @db.Decimal(5,2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}